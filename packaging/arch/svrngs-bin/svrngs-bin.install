# Copied by ../bump from svrngs packaging/arch/svrngs-bin.install@a6f091c059820a3d1b8cdf975a693342ac39e91f.
post_install() {
  echo "svrngs: to keep it running whenever you log in, run as yourself:"
  echo "  systemctl --user enable --now svrngs"
}

post_upgrade() {
  echo "svrngs: run 'svrngs restart' to use the new version."
}
