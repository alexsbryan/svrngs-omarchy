# Copied by ../bump from svrngs packaging/arch/svrngs-give-bin.install@e5d9813b46f8c5b5f12bb87feb850bdedb68f8bf.
post_install() {
  echo "give: to keep apps for your groups whenever you log in, run as yourself:"
  echo "  systemctl --user enable --now give"
}

post_upgrade() {
  echo "give: run 'systemctl --user restart give' to use the new version."
  echo "  It copies each app it keeps as it stops, and starts them again."
}
